/**
 * @file ethernetif.c
 * @brief Driver de interface Ethernet para LwIP no STM32F429ZI.
 *
 * Este arquivo implementa a interface de rede (netif) entre o LwIP e o
 * controlador Ethernet do STM32F429. Gerencia a transmissão e recepção
 * de pacotes Ethernet usando DMA.
 *
 * @note O STM32F429ZI possui um controlador Ethernet MAC integrado com
 *       suporte a IEEE 802.3 e interface RMII/MII.
 */

#include "lwip/opt.h"
#include "lwip/def.h"
#include "lwip/mem.h"
#include "lwip/pbuf.h"
#include "lwip/sys.h"
#include "lwip/stats.h"
#include "lwip/snmp.h"
#include "lwip/ethip6.h"
#include "lwip/etharp.h"
#include "lwip/tcpip.h"
#include "netif/ethernet.h"

#include "ethernetif.h"

#include "FreeRTOS.h"
#include "task.h"
#include "semphr.h"

#include <string.h>
#include <stdio.h>

/* Função externa para verificar estado do link PHY */
extern int ethPhyGetLinkStatus(void);

/*-----------------------------------------------------------------------------
 * Definições e Constantes
 *----------------------------------------------------------------------------*/

/**
 * @brief Nome da interface de rede (2 caracteres).
 */
#define IFNAME0 's'
#define IFNAME1 't'

/**
 * @brief Tamanho do buffer de transmissão/recepção.
 */
#define ETH_RX_BUFFER_SIZE      1524
#define ETH_TX_BUFFER_SIZE      1524

/**
 * @brief Número de descritores de DMA.
 */
#define ETH_RXBUFNB             4
#define ETH_TXBUFNB             4

/**
 * @brief Tamanho da pilha da tarefa de recepção.
 */
#define ETHERNETIF_TASK_STACK_SIZE      512

/**
 * @brief Prioridade da tarefa de recepção.
 */
#define ETHERNETIF_TASK_PRIORITY        (configMAX_PRIORITIES - 1)

/*-----------------------------------------------------------------------------
 * Estruturas de Controle
 *----------------------------------------------------------------------------*/

/**
 * @brief Estrutura de controle da interface Ethernet.
 */
typedef struct
{
    struct netif *netif;           /**< Interface de rede LwIP */
    SemaphoreHandle_t rxSemaphore; /**< Semáforo para recepção */
    TaskHandle_t rxTaskHandle;     /**< Handle da tarefa de recepção */
    uint8_t macAddr[6];            /**< Endereço MAC */
    volatile uint8_t linkUp;       /**< Estado do link */
} EthernetIfControl_t;

/*-----------------------------------------------------------------------------
 * Variáveis Estáticas
 *----------------------------------------------------------------------------*/

/**
 * @brief Estrutura de controle global da interface Ethernet.
 */
static EthernetIfControl_t ethIfControl;

/**
 * @brief Buffers de transmissão e recepção (alinhados para DMA).
 */
__attribute__((aligned(4))) static uint8_t ethRxBuffer[ETH_RXBUFNB][ETH_RX_BUFFER_SIZE];
__attribute__((aligned(4))) static uint8_t ethTxBuffer[ETH_TXBUFNB][ETH_TX_BUFFER_SIZE];

/**
 * @brief Índices atuais dos buffers.
 */
static volatile uint32_t rxBufferIndex = 0;
static volatile uint32_t txBufferIndex = 0;

/*-----------------------------------------------------------------------------
 * Registradores do Controlador Ethernet STM32F429
 *----------------------------------------------------------------------------*/

/**
 * @brief Endereço base do controlador Ethernet.
 */
#define ETH_BASE            0x40028000UL
#define ETH_MAC_BASE        (ETH_BASE)
#define ETH_DMA_BASE        (ETH_BASE + 0x1000UL)

/**
 * @brief Registradores MAC.
 */
#define ETH_MACCR           (*(volatile uint32_t *)(ETH_MAC_BASE + 0x00))
#define ETH_MACFFR          (*(volatile uint32_t *)(ETH_MAC_BASE + 0x04))
#define ETH_MACHTHR         (*(volatile uint32_t *)(ETH_MAC_BASE + 0x08))
#define ETH_MACHTLR         (*(volatile uint32_t *)(ETH_MAC_BASE + 0x0C))
#define ETH_MACMIIAR        (*(volatile uint32_t *)(ETH_MAC_BASE + 0x10))
#define ETH_MACMIIDR        (*(volatile uint32_t *)(ETH_MAC_BASE + 0x14))
#define ETH_MACFCR          (*(volatile uint32_t *)(ETH_MAC_BASE + 0x18))
#define ETH_MACVLANTR       (*(volatile uint32_t *)(ETH_MAC_BASE + 0x1C))
#define ETH_MACRWUFFR       (*(volatile uint32_t *)(ETH_MAC_BASE + 0x28))
#define ETH_MACPMTCSR       (*(volatile uint32_t *)(ETH_MAC_BASE + 0x2C))
#define ETH_MACSR           (*(volatile uint32_t *)(ETH_MAC_BASE + 0x38))
#define ETH_MACIMR          (*(volatile uint32_t *)(ETH_MAC_BASE + 0x3C))
#define ETH_MACA0HR         (*(volatile uint32_t *)(ETH_MAC_BASE + 0x40))
#define ETH_MACA0LR         (*(volatile uint32_t *)(ETH_MAC_BASE + 0x44))

/**
 * @brief Registradores DMA.
 */
#define ETH_DMABMR          (*(volatile uint32_t *)(ETH_DMA_BASE + 0x00))
#define ETH_DMATPDR         (*(volatile uint32_t *)(ETH_DMA_BASE + 0x04))
#define ETH_DMARPDR         (*(volatile uint32_t *)(ETH_DMA_BASE + 0x08))
#define ETH_DMARDLAR        (*(volatile uint32_t *)(ETH_DMA_BASE + 0x0C))
#define ETH_DMATDLAR        (*(volatile uint32_t *)(ETH_DMA_BASE + 0x10))
#define ETH_DMASR           (*(volatile uint32_t *)(ETH_DMA_BASE + 0x14))
#define ETH_DMAOMR          (*(volatile uint32_t *)(ETH_DMA_BASE + 0x18))
#define ETH_DMAIER          (*(volatile uint32_t *)(ETH_DMA_BASE + 0x1C))
#define ETH_DMAMFBOCR       (*(volatile uint32_t *)(ETH_DMA_BASE + 0x20))
#define ETH_DMACHTDR        (*(volatile uint32_t *)(ETH_DMA_BASE + 0x48))
#define ETH_DMACHRDR        (*(volatile uint32_t *)(ETH_DMA_BASE + 0x4C))
#define ETH_DMACHTBAR       (*(volatile uint32_t *)(ETH_DMA_BASE + 0x50))
#define ETH_DMACHRBAR       (*(volatile uint32_t *)(ETH_DMA_BASE + 0x54))

/**
 * @brief Bits de controle importantes.
 */
#define ETH_MACCR_RE        (1U << 2)   /* Receiver Enable */
#define ETH_MACCR_TE        (1U << 3)   /* Transmitter Enable */
#define ETH_MACCR_DC        (1U << 4)   /* Deferral Check */
#define ETH_MACCR_APCS      (1U << 7)   /* Automatic Pad/CRC Stripping */
#define ETH_MACCR_RD        (1U << 9)   /* Retry Disable */
#define ETH_MACCR_IPCO      (1U << 10)  /* IPv4 Checksum Offload */
#define ETH_MACCR_DM        (1U << 11)  /* Duplex Mode */
#define ETH_MACCR_LM        (1U << 12)  /* Loopback Mode */
#define ETH_MACCR_ROD       (1U << 13)  /* Receive Own Disable */
#define ETH_MACCR_FES       (1U << 14)  /* Fast Ethernet Speed (100Mbps) */
#define ETH_MACCR_CSD       (1U << 16)  /* Carrier Sense Disable */
#define ETH_MACCR_IFG       (0U << 17)  /* Inter-Frame Gap */
#define ETH_MACCR_JD        (1U << 22)  /* Jabber Disable */
#define ETH_MACCR_WD        (1U << 23)  /* Watchdog Disable */

#define ETH_DMAOMR_SR       (1U << 1)   /* Start/Stop Receive */
#define ETH_DMAOMR_ST       (1U << 13)  /* Start/Stop Transmission */
#define ETH_DMAOMR_FTF      (1U << 20)  /* Flush Transmit FIFO */
#define ETH_DMAOMR_TSF      (1U << 21)  /* Transmit Store and Forward */
#define ETH_DMAOMR_RSF      (1U << 25)  /* Receive Store and Forward */

#define ETH_DMABMR_SR       (1U << 0)   /* Software Reset */
#define ETH_DMABMR_DA       (1U << 1)   /* DMA Arbitration */
#define ETH_DMABMR_PBL      (4U << 8)   /* Programmable Burst Length */
#define ETH_DMABMR_EDFE     (1U << 7)   /* Enhanced Descriptor Format Enable */
#define ETH_DMABMR_USP      (1U << 23)  /* Use Separate PBL */
#define ETH_DMABMR_RDP      (4U << 17)  /* Rx DMA PBL */
#define ETH_DMABMR_FB       (1U << 16)  /* Fixed Burst */
#define ETH_DMABMR_AAB      (1U << 25)  /* Address-Aligned Beats */

/*-----------------------------------------------------------------------------
 * Descritores DMA
 *----------------------------------------------------------------------------*/

/**
 * @brief Estrutura do descritor DMA (formato enhanced).
 */
typedef struct
{
    volatile uint32_t status;      /**< Status/Control do descritor */
    volatile uint32_t controlLen;  /**< Tamanho do buffer e flags */
    volatile uint32_t buffer1Addr; /**< Endereço do buffer 1 */
    volatile uint32_t buffer2Addr; /**< Endereço do buffer 2 ou próximo descritor */
    volatile uint32_t extStatus;   /**< Status estendido (enhanced mode) */
    volatile uint32_t reserved1;   /**< Reservado */
    volatile uint32_t timeStampLow;/**< Timestamp baixo */
    volatile uint32_t timeStampHigh;/**< Timestamp alto */
} EthDmaDescriptor_t;

/**
 * @brief Bits de status do descritor de recepção.
 */
#define ETH_DMARXDESC_OWN   (1U << 31)  /* OWN bit: DMA owns descriptor */
#define ETH_DMARXDESC_FL    (0x3FFF << 16) /* Frame Length mask */
#define ETH_DMARXDESC_ES    (1U << 15)  /* Error Summary */
#define ETH_DMARXDESC_LS    (1U << 8)   /* Last Segment */
#define ETH_DMARXDESC_FS    (1U << 9)   /* First Segment */

/**
 * @brief Bits de status do descritor de transmissão.
 */
#define ETH_DMATXDESC_OWN   (1U << 31)  /* OWN bit: DMA owns descriptor */
#define ETH_DMATXDESC_IC    (1U << 30)  /* Interrupt on Completion */
#define ETH_DMATXDESC_LS    (1U << 29)  /* Last Segment */
#define ETH_DMATXDESC_FS    (1U << 28)  /* First Segment */
#define ETH_DMATXDESC_TCH   (1U << 20)  /* Transmit Chained */
#define ETH_DMATXDESC_TER   (1U << 21)  /* Transmit End of Ring */

/**
 * @brief Descritores DMA (alinhados para DMA).
 */
__attribute__((aligned(4))) static EthDmaDescriptor_t dmaRxDescriptors[ETH_RXBUFNB];
__attribute__((aligned(4))) static EthDmaDescriptor_t dmaTxDescriptors[ETH_TXBUFNB];

/*-----------------------------------------------------------------------------
 * Protótipos de Funções Privadas
 *----------------------------------------------------------------------------*/

static void ethernetIfInitHardware(void);
static void ethernetIfInitDma(void);
static err_t ethernetIfOutput(struct netif *netif, struct pbuf *p);
static struct pbuf *ethernetIfInput(struct netif *netif);
static void ethernetIfTask(void *pvParameters);

/*-----------------------------------------------------------------------------
 * Implementação das Funções Públicas
 *----------------------------------------------------------------------------*/

/**
 * @brief Inicializa a interface de rede Ethernet.
 *
 * Esta função é chamada pelo LwIP durante netif_add() para configurar
 * a interface de rede. Configura o hardware Ethernet, inicializa os
 * descritores DMA e cria a tarefa de recepção.
 *
 * @param netif Ponteiro para a estrutura netif do LwIP.
 * @return ERR_OK se sucesso, código de erro caso contrário.
 */
err_t ethernetIfInit(struct netif *netif)
{
    LWIP_ASSERT("netif != NULL", (netif != NULL));

    /* Salvar referência da interface */
    ethIfControl.netif = netif;

    /* Configurar nome da interface */
    netif->name[0] = IFNAME0;
    netif->name[1] = IFNAME1;

    /* Configurar funções de callback */
    netif->output = etharp_output;
    netif->linkoutput = ethernetIfOutput;

    /* Configurar endereço MAC (pode ser configurado via parâmetro) */
    ethIfControl.macAddr[0] = 0x02;
    ethIfControl.macAddr[1] = 0x00;
    ethIfControl.macAddr[2] = 0x00;
    ethIfControl.macAddr[3] = 0x00;
    ethIfControl.macAddr[4] = 0x00;
    ethIfControl.macAddr[5] = 0x01;

    netif->hwaddr_len = 6;
    memcpy(netif->hwaddr, ethIfControl.macAddr, 6);

    /* Configurar MTU e flags */
    netif->mtu = 1500;
    netif->flags = NETIF_FLAG_BROADCAST | NETIF_FLAG_ETHARP | NETIF_FLAG_ETHERNET;

    /* Inicializar hardware Ethernet */
    ethernetIfInitHardware();

    /* Inicializar DMA */
    ethernetIfInitDma();

    /* Criar semáforo de recepção */
    ethIfControl.rxSemaphore = xSemaphoreCreateBinary();
    if (ethIfControl.rxSemaphore == NULL)
    {
        return ERR_MEM;
    }

    /* Criar tarefa de recepção */
    BaseType_t result = xTaskCreate(ethernetIfTask,
                                    "EthRx",
                                    ETHERNETIF_TASK_STACK_SIZE,
                                    netif,
                                    ETHERNETIF_TASK_PRIORITY,
                                    &ethIfControl.rxTaskHandle);

    if (result != pdPASS)
    {
        return ERR_MEM;
    }

    /* Verificar estado real do link via PHY */
    int linkState = ethPhyGetLinkStatus();
    if (linkState > 0)
    {
        ethIfControl.linkUp = 1;
        netif_set_link_up(netif);
        printf("[EthIf] Link fisico detectado\n");
    }
    else
    {
        ethIfControl.linkUp = 0;
        netif_set_link_down(netif);
        printf("[EthIf] Link fisico NAO detectado - aguardando conexao\n");
    }

    return ERR_OK;
}

/**
 * @brief Configura o endereço MAC da interface.
 *
 * @param macAddr Array de 6 bytes com o endereço MAC.
 */
void ethernetIfSetMacAddress(const uint8_t *macAddr)
{
    if (macAddr != NULL)
    {
        memcpy(ethIfControl.macAddr, macAddr, 6);
        
        if (ethIfControl.netif != NULL)
        {
            memcpy(ethIfControl.netif->hwaddr, macAddr, 6);
        }

        /* Atualizar registrador MAC do hardware */
        ETH_MACA0HR = ((uint32_t)macAddr[5] << 8) | (uint32_t)macAddr[4];
        ETH_MACA0LR = ((uint32_t)macAddr[3] << 24) | ((uint32_t)macAddr[2] << 16) |
                      ((uint32_t)macAddr[1] << 8) | (uint32_t)macAddr[0];
    }
}

/**
 * @brief Retorna o estado do link Ethernet.
 *
 * @return 1 se link ativo, 0 se inativo.
 */
uint8_t ethernetIfGetLinkState(void)
{
    return ethIfControl.linkUp;
}

/*-----------------------------------------------------------------------------
 * Implementação das Funções Privadas
 *----------------------------------------------------------------------------*/

/**
 * @brief Inicializa o hardware do controlador Ethernet.
 *
 * Configura os clocks, GPIOs e registradores do controlador Ethernet
 * do STM32F429ZI.
 */
static void ethernetIfInitHardware(void)
{
    /* 
     * NOTA: Esta é uma implementação simplificada.
     * Em um projeto real, é necessário:
     * 1. Habilitar clocks do Ethernet (RCC)
     * 2. Configurar GPIOs para RMII/MII
     * 3. Configurar o PHY externo
     * 4. Aguardar estabilização do link
     */

    /* Reset do DMA */
    ETH_DMABMR = ETH_DMABMR_SR;
    while ((ETH_DMABMR & ETH_DMABMR_SR) != 0)
    {
        /* Aguardar reset completar */
    }

    /* Configurar modo DMA */
    ETH_DMABMR = ETH_DMABMR_AAB | ETH_DMABMR_FB | ETH_DMABMR_PBL |
                 ETH_DMABMR_RDP | ETH_DMABMR_USP | ETH_DMABMR_EDFE;

    /* Configurar endereço MAC */
    ETH_MACA0HR = ((uint32_t)ethIfControl.macAddr[5] << 8) |
                  (uint32_t)ethIfControl.macAddr[4];
    ETH_MACA0LR = ((uint32_t)ethIfControl.macAddr[3] << 24) |
                  ((uint32_t)ethIfControl.macAddr[2] << 16) |
                  ((uint32_t)ethIfControl.macAddr[1] << 8) |
                  (uint32_t)ethIfControl.macAddr[0];

    /* Configurar modo MAC: Full Duplex, 100Mbps */
    ETH_MACCR = ETH_MACCR_FES | ETH_MACCR_DM | ETH_MACCR_APCS |
                ETH_MACCR_RD | ETH_MACCR_IPCO;

    /* Configurar filtro de frames (aceitar todos por enquanto) */
    ETH_MACFFR = 0;

    /* Configurar modo de operação DMA */
    ETH_DMAOMR = ETH_DMAOMR_RSF | ETH_DMAOMR_TSF | ETH_DMAOMR_FTF;
}

/**
 * @brief Inicializa os descritores DMA para transmissão e recepção.
 *
 * Configura a cadeia de descritores DMA e associa os buffers de memória.
 */
static void ethernetIfInitDma(void)
{
    uint32_t i;

    /* Inicializar descritores de recepção */
    for (i = 0; i < ETH_RXBUFNB; i++)
    {
        dmaRxDescriptors[i].status = ETH_DMARXDESC_OWN;
        dmaRxDescriptors[i].controlLen = ETH_RX_BUFFER_SIZE;
        dmaRxDescriptors[i].buffer1Addr = (uint32_t)ethRxBuffer[i];
        dmaRxDescriptors[i].buffer2Addr = (uint32_t)&dmaRxDescriptors[(i + 1) % ETH_RXBUFNB];
        dmaRxDescriptors[i].extStatus = 0;
        dmaRxDescriptors[i].reserved1 = 0;
        dmaRxDescriptors[i].timeStampLow = 0;
        dmaRxDescriptors[i].timeStampHigh = 0;
    }

    /* Inicializar descritores de transmissão */
    for (i = 0; i < ETH_TXBUFNB; i++)
    {
        dmaTxDescriptors[i].status = 0;
        dmaTxDescriptors[i].controlLen = ETH_DMATXDESC_TCH;
        dmaTxDescriptors[i].buffer1Addr = (uint32_t)ethTxBuffer[i];
        dmaTxDescriptors[i].buffer2Addr = (uint32_t)&dmaTxDescriptors[(i + 1) % ETH_TXBUFNB];
        dmaTxDescriptors[i].extStatus = 0;
        dmaTxDescriptors[i].reserved1 = 0;
        dmaTxDescriptors[i].timeStampLow = 0;
        dmaTxDescriptors[i].timeStampHigh = 0;
    }

    /* Configurar endereços base dos descritores */
    ETH_DMARDLAR = (uint32_t)dmaRxDescriptors;
    ETH_DMATDLAR = (uint32_t)dmaTxDescriptors;

    /* Habilitar transmissão e recepção */
    ETH_MACCR |= (ETH_MACCR_TE | ETH_MACCR_RE);
    ETH_DMAOMR |= (ETH_DMAOMR_ST | ETH_DMAOMR_SR);
}

/**
 * @brief Transmite um pacote pela interface Ethernet.
 *
 * @param netif Interface de rede.
 * @param p Cadeia de pbufs contendo o pacote a transmitir.
 * @return ERR_OK se sucesso, código de erro caso contrário.
 */
static err_t ethernetIfOutput(struct netif *netif, struct pbuf *p)
{
    struct pbuf *q;
    uint8_t *buffer;
    uint32_t len = 0;
    uint32_t idx = txBufferIndex;

    (void)netif;

    /* Verificar se descritor está disponível */
    if ((dmaTxDescriptors[idx].status & ETH_DMATXDESC_OWN) != 0)
    {
        return ERR_USE;
    }

    /* Copiar dados do pbuf para o buffer de transmissão */
    buffer = ethTxBuffer[idx];
    for (q = p; q != NULL; q = q->next)
    {
        if ((len + q->len) > ETH_TX_BUFFER_SIZE)
        {
            return ERR_BUF;
        }
        memcpy(&buffer[len], q->payload, q->len);
        len += q->len;
    }

    /* Configurar descritor para transmissão */
    dmaTxDescriptors[idx].controlLen = len | ETH_DMATXDESC_TCH;
    dmaTxDescriptors[idx].status = ETH_DMATXDESC_OWN | ETH_DMATXDESC_FS |
                                   ETH_DMATXDESC_LS | ETH_DMATXDESC_IC;

    /* Avançar índice */
    txBufferIndex = (txBufferIndex + 1) % ETH_TXBUFNB;

    /* Iniciar transmissão */
    if ((ETH_DMASR & (1U << 2)) != 0)
    {
        ETH_DMASR = (1U << 2); /* Limpar flag de buffer indisponível */
    }
    ETH_DMATPDR = 0; /* Poll demand */

    LINK_STATS_INC(link.xmit);

    return ERR_OK;
}

/**
 * @brief Recebe um pacote da interface Ethernet.
 *
 * @param netif Interface de rede.
 * @return Ponteiro para pbuf contendo o pacote, ou NULL se não há pacotes.
 */
static struct pbuf *ethernetIfInput(struct netif *netif)
{
    struct pbuf *p = NULL;
    uint32_t len;
    uint32_t idx = rxBufferIndex;

    (void)netif;

    /* Verificar se há pacote recebido */
    if ((dmaRxDescriptors[idx].status & ETH_DMARXDESC_OWN) != 0)
    {
        return NULL;
    }

    /* Verificar erros */
    if ((dmaRxDescriptors[idx].status & ETH_DMARXDESC_ES) != 0)
    {
        LINK_STATS_INC(link.err);
        LINK_STATS_INC(link.drop);
        /* Liberar descritor para DMA */
        dmaRxDescriptors[idx].status = ETH_DMARXDESC_OWN;
        rxBufferIndex = (rxBufferIndex + 1) % ETH_RXBUFNB;
        return NULL;
    }

    /* Obter tamanho do frame (excluindo CRC) */
    len = ((dmaRxDescriptors[idx].status & ETH_DMARXDESC_FL) >> 16) - 4;

    if (len > 0 && len <= ETH_RX_BUFFER_SIZE)
    {
        /* Alocar pbuf e copiar dados */
        p = pbuf_alloc(PBUF_RAW, (u16_t)len, PBUF_POOL);
        if (p != NULL)
        {
            struct pbuf *q;
            uint8_t *buffer = ethRxBuffer[idx];
            uint32_t offset = 0;

            for (q = p; q != NULL; q = q->next)
            {
                memcpy(q->payload, &buffer[offset], q->len);
                offset += q->len;
            }

            LINK_STATS_INC(link.recv);
        }
        else
        {
            LINK_STATS_INC(link.memerr);
            LINK_STATS_INC(link.drop);
        }
    }

    /* Liberar descritor para DMA */
    dmaRxDescriptors[idx].status = ETH_DMARXDESC_OWN;
    rxBufferIndex = (rxBufferIndex + 1) % ETH_RXBUFNB;

    /* Reiniciar recepção se necessário */
    if ((ETH_DMASR & (1U << 7)) != 0)
    {
        ETH_DMASR = (1U << 7); /* Limpar flag de buffer indisponível */
    }
    ETH_DMARPDR = 0; /* Poll demand */

    return p;
}

/**
 * @brief Tarefa de recepção de pacotes Ethernet.
 *
 * Esta tarefa roda continuamente verificando a chegada de novos pacotes
 * e os encaminha para a pilha TCP/IP. Também monitora o estado do link.
 *
 * @param pvParameters Ponteiro para a estrutura netif.
 */
static void ethernetIfTask(void *pvParameters)
{
    struct netif *netif = (struct netif *)pvParameters;
    struct pbuf *p;
    uint32_t linkCheckCounter = 0;

    for (;;)
    {
        /* Verificar se há pacotes para processar */
        p = ethernetIfInput(netif);

        if (p != NULL)
        {
            /* Enviar pacote para a pilha TCP/IP */
            if (netif->input(p, netif) != ERR_OK)
            {
                pbuf_free(p);
            }
        }
        else
        {
            /* Aguardar um pouco antes de verificar novamente */
            vTaskDelay(pdMS_TO_TICKS(1));
        }

        /* Verificar estado do link periodicamente (a cada ~1 segundo) */
        linkCheckCounter++;
        if (linkCheckCounter >= 1000)
        {
            linkCheckCounter = 0;

            int linkState = ethPhyGetLinkStatus();
            if (linkState > 0 && !ethIfControl.linkUp)
            {
                /* Link acabou de ser estabelecido */
                ethIfControl.linkUp = 1;
                netif_set_link_up(netif);
                printf("[EthIf] Link estabelecido!\n");
            }
            else if (linkState <= 0 && ethIfControl.linkUp)
            {
                /* Link foi perdido */
                ethIfControl.linkUp = 0;
                netif_set_link_down(netif);
                printf("[EthIf] Link perdido!\n");
            }
        }
    }
}

/**
 * @brief Handler de interrupção do Ethernet (opcional).
 *
 * Este handler pode ser usado para notificar a tarefa de recepção
 * via semáforo quando um pacote é recebido.
 */
void ETH_IRQHandler(void)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    /* Verificar flag de recepção */
    if ((ETH_DMASR & (1U << 6)) != 0)
    {
        ETH_DMASR = (1U << 6); /* Limpar flag */

        if (ethIfControl.rxSemaphore != NULL)
        {
            xSemaphoreGiveFromISR(ethIfControl.rxSemaphore, &xHigherPriorityTaskWoken);
        }
    }

    /* Limpar flag de interrupção normal */
    if ((ETH_DMASR & (1U << 16)) != 0)
    {
        ETH_DMASR = (1U << 16);
    }

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}
