# =============================================================================
# Arquivo de Configuração de Ambiente - env.cmake
# =============================================================================
# Este arquivo define as variáveis de ambiente para parametrização do projeto.
# Copie este arquivo para env.cmake e ajuste os valores conforme necessário.
#
# IMPORTANTE: O arquivo env.cmake NÃO deve ser versionado (está no .gitignore).
#
# LEGENDA:
#   [OBRIGATÓRIO] - Variável deve ser definida, sem valor padrão
#   [OPCIONAL]    - Variável com valor padrão se não definida
#   [PADRÃO: X]   - Valor padrão usado se não definida
# =============================================================================

message(STATUS "Arquivo env.cmake sendo carregado.")

# -----------------------------------------------------------------------------
# Versão do Sistema [OPCIONAL - PADRÃO: "0.0.1"]
# -----------------------------------------------------------------------------
set(ENV{RACK_VERSION} "0.0.50")

# -----------------------------------------------------------------------------
# Configuração de Log [OPCIONAL - PADRÃO: 1 (ERROR)]
# -----------------------------------------------------------------------------
# Níveis: 0=OFF, 1=ERROR, 2=WARN, 3=INFO, 4=DEBUG, 5=VERBOSE
set(ENV{LOG_LEVEL} "4")

# -----------------------------------------------------------------------------
# Configuração de Rede (se aplicável)
# -----------------------------------------------------------------------------
set(ENV{WIFI_SSID} "MinhaRede")
set(ENV{WIFI_PASSWORD} "MinhaSenha")

# -----------------------------------------------------------------------------
# Configuração do Broker MQTT
# -----------------------------------------------------------------------------

# [OPCIONAL - PADRÃO: "mqtt.rapport.tec.br"]
# Endereço do broker (hostname ou IP)
set(ENV{MQTT_BROKER} "mqtt.rapport.tec.br")

# [OBRIGATÓRIO] Porta do broker (1883 sem TLS, 8883 com TLS)
set(ENV{MQTT_BROKER_PORT} "1883")

# [OBRIGATÓRIO] Identificador único do cliente MQTT (deve ser único por dispositivo)
set(ENV{MQTT_CLIENT_ID} "STM32F429ZI_Rack")

# [OPCIONAL] Credenciais de autenticação (deixe "" se o broker não requer)
set(ENV{MQTT_USERNAME} "rack")
set(ENV{MQTT_PASSWORD} "rack4567senha")

# -----------------------------------------------------------------------------
# Configuração de Tópicos MQTT
# -----------------------------------------------------------------------------

# [OBRIGATÓRIO] Tópico base para publicação/subscrição
# Formato final: <base>/<rack_number>/temperature
#                <base>/<rack_number>/fan/command
#                <base>/<rack_number>/fan/status
set(ENV{MQTT_BASE_TOPIC} "racks")

# [OBRIGATÓRIO] Identificador do rack/dispositivo
set(ENV{MQTT_RACK_NUMBER} "STM32F429")

# -----------------------------------------------------------------------------
# Configuração de Comportamento MQTT
# -----------------------------------------------------------------------------

# [OBRIGATÓRIO] Intervalo de publicação da temperatura em milissegundos
set(ENV{MQTT_PUBLISH_INTERVAL_MS} "5000")

# [OBRIGATÓRIO] Quality of Service (0, 1 ou 2)
set(ENV{MQTT_QOS} "1")

# [OBRIGATÓRIO] Keep-alive em segundos
set(ENV{MQTT_KEEP_ALIVE_S} "60")

# -----------------------------------------------------------------------------
# Configuração de Debug [OPCIONAL - PADRÃO: 0]
# -----------------------------------------------------------------------------
set(ENV{ENABLE_STACK_WATERMARK} "1")

message(STATUS "Variáveis do env.cmake carregadas com sucesso.")